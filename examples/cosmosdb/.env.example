# Copy to .env (never commit it) or set these in your scheduler / secret store.
# Passwords: prefer the OS keychain over this file: odcr secret set PGPASSWORD, then in odcr.yaml
# write password: ${keyring:PGPASSWORD}. Managed identities / IAM roles need no password at all.
# Connection: Azure Cosmos DB (NoSQL)
COSMOS_DATABASE=odcr
COSMOS_ENDPOINT=
COSMOS_KEY=
ORDERS_SLACK_WEBHOOK=
ORDERS_TEAMS_WEBHOOK=
PLATFORM_TEAMS_WEBHOOK=
SMTP_HOST=smtp.example.com
SMTP_PORT=25
